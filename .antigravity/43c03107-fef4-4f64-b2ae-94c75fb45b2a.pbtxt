      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Update generateAppBuildGradleKts, generateGitHubActionsApkYaml, and generateFullAndroidSetupScript in src/utils/kotlinGenerator.ts to build signed Production Release APK\",\"EndLine\":529,\"Instruction\":\"Replace generateAppBuildGradleKts, generateGitHubActionsApkYaml, and generateFullAndroidSetupScript with Production Release R8 + Keystore signing configuration in src/utils/kotlinGenerator.ts\",\"ReplacementContent\":\"export function generateAppBuildGradleKts(): string {\\n  return `plugins {\\n    id(\\\"com.android.application\\\")\\n    id(\\\"org.jetbrains.kotlin.android\\\")\\n}\\n\\nandroid {\\n    namespace = \\\"com.miguard.dns\\\"\\n    compileSdk = 34\\n\\n    defaultConfig {\\n        applicationId = \\\"com.miguard.dns\\\"\\n        minSdk = 26\\n        targetSdk = 34\\n        versionCode = 1\\n        versionName = \\\"1.0.0\\\"\\n    }\\n\\n    signingConfigs {\\n        create(\\\"release\\\") {\\n            val keystoreFile = file(System.getenv(\\\"KEYSTORE_PATH\\\") ?: \\\"release-keystore.jks\\\")\\n            if (keystoreFile.exists()) {\\n                storeFile = keystoreFile\\n                storePassword = System.getenv(\\\"KEYSTORE_PASSWORD\\\") ?: \\\"miguard_prod_2026\\\"\\n                keyAlias = System.getenv(\\\"KEY_ALIAS\\\") ?: \\\"miguard_key\\\"\\n                keyPassword = System.getenv(\\\"KEY_PASSWORD\\\") ?: \\\"miguard_prod_2026\\\"\\n            } else {\\n                val debugConfig = getByName(\\\"debug\\\")\\n                storeFile = debugConfig.storeFile\\n                storePassword = debugConfig.storePassword\\n                keyAlias = debugConfig.keyAlias\\n                keyPassword = debugConfig.keyPassword\\n            }\\n        }\\n    }\\n\\n    buildTypes {\\n        release {\\n            // B\341\272\243n Production th\341\273\261c th\341\273\245: B\341\272\255t R8 thu g\341\273\215n code, x\303\263a t\303\240i nguy\303\252n th\341\273\253a v\303\240 k\303\275 s\341\273\221 APK\\n            isMinifyEnabled = true\\n            isShrinkResources = true\\n            isDebuggable = false\\n            signingConfig = signingConfigs.getByName(\\\"release\\\")\\n            proguardFiles(\\n                getDefaultProguardFile(\\\"proguard-android-optimize.txt\\\"),\\n                \\\"proguard-rules.pro\\\"\\n            )\\n        }\\n        debug {\\n            applicationIdSuffix = \\\".debug\\\"\\n            versionNameSuffix = \\\"-debug\\\"\\n        }\\n    }\\n\\n    compileOptions {\\n        sourceCompatibility = JavaVersion.VERSION_17\\n        targetCompatibility = JavaVersion.VERSION_17\\n    }\\n\\n    kotlinOptions {\\n        jvmTarget = \\\"17\\\"\\n    }\\n\\n    buildFeatures {\\n        compose = true\\n    }\\n\\n    composeOptions {\\n        kotlinCompilerExtensionVersion = \\\"1.5.14\\\"\\n    }\\n\\n    packaging {\\n        resources {\\n            excludes += \\\"/META-INF/{AL2.0,LGPL2.1}\\\"\\n            excludes += \\\"DebugProbesKt.bin\\\"\\n        }\\n    }\\n}\\n\\ndependencies {\\n    val composeBom = platform(\\\"androidx.compose:compose-bom:2024.06.00\\\")\\n    implementation(composeBom)\\n    implementation(\\\"androidx.core:core-ktx:1.13.1\\\")\\n    implementation(\\\"androidx.lifecycle:lifecycle-runtime-ktx:2.8.3\\\")\\n    implementation(\\\"androidx.activity:activity-compose:1.9.0\\\")\\n    implementation(\\\"androidx.compose.ui:ui\\\")\\n    implementation(\\\"androidx.compose.material3:material3\\\")\\n}`;\\n}\\n\\nexport function generateGitHubActionsApkYaml(): string {\\n  return `name: Build MiGuard DNS Production Release APK\\n\\non:\\n  push:\\n    branches: [ \\\"main\\\", \\\"master\\\" ]\\n  workflow_dispatch:\\n\\njobs:\\n  build-apk:\\n    runs-on: ubuntu-latest\\n    steps:\\n      - name: Checkout repository\\n        uses: actions/checkout@v4\\n\\n      - name: Set up JDK 17\\n        uses: actions/setup-java@v4\\n        with:\\n          java-version: \'17\'\\n          distribution: \'temurin\'\\n\\n      - name: Setup Gradle 8.7\\n        uses: gradle/actions/setup-gradle@v3\\n        with:\\n          gradle-version: \'8.7\'\\n\\n      - name: Generate Production Release Keystore\\n        working-directory: ./android/app\\n        run: |\\n          if [ ! -f release-keystore.jks ]; then\\n            keytool -genkeypair -v \\\\\\\\\\n              -keystore release-keystore.jks \\\\\\\\\\n              -alias miguard_key \\\\\\\\\\n              -keyalg RSA \\\\\\\\\\n              -keysize 2048 \\\\\\\\\\n              -validity 10000 \\\\\\\\\\n              -storepass miguard_prod_2026 \\\\\\\\\\n              -keypass miguard_prod_2026 \\\\\\\\\\n              -dname \\\"CN=MiGuard DNS, OU=Mobile, O=MiGuard, L=Hanoi, S=HN, C=VN\\\"\\n          fi\\n\\n      - name: Build Signed Production Release APK (R8 Minified & Shrunk)\\n        working-directory: ./android\\n        env:\\n          KEYSTORE_PASSWORD: miguard_prod_2026\\n          KEY_ALIAS: miguard_key\\n          KEY_PASSWORD: miguard_prod_2026\\n        run: gradle assembleRelease --no-daemon\\n\\n      - name: Upload MiGuard-DNS-Production-Release.apk\\n        uses: actions/upload-artifact@v4\\n        with:\\n          name: MiGuard-DNS-Production-Release-APK\\n          path: android/app/build/outputs/apk/release/app-release.apk`;\\n}\\n\\nexport function generateFullAndroidSetupScript(\\n  rules: DomainRule[],\\n  upstreamDns: DnsUpstream,\\n  secondaryDns: DnsUpstream,\\n  filterMode: AppFilterMode,\\n  packages: SystemPackageItem[],\\n  logRetentionDays: LogRetentionDays\\n): string {\\n  const vpnServiceKt = generateKotlinVpnServiceCode(\\n    rules,\\n    upstreamDns,\\n    secondaryDns,\\n    filterMode,\\n    packages,\\n    logRetentionDays\\n  );\\n  const packetHelperKt = generateDnsPacketHelperCode();\\n  const manifestXml = generateAndroidManifestXml();\\n  const appGradle = generateAppBu