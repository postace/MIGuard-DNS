    content: "                            : \'text-slate-900 dark:text-slate-100\'\n                        }`}\n                      >\n                        {entry.domain}\n                      </p>\n                      <div className=\"mt-0.5 flex items-center gap-1.5 text-[11px] text-slate-500 dark:text-slate-400 font-mono\">\n                        <span>{formatRelativeAge(entry.createdAt)}</span>\n                        <span aria-hidden=\"true\">\302\267</span>\n                        <span>{entry.timestamp}</span>\n                        <span aria-hidden=\"true\">\302\267</span>\n                        <span className=\"truncate\">{entry.packageName}</span>\n                      </div>\n                    </div>\n\n                    <div className=\"text-right font-mono tabular-nums shrink-0\">\n                      <span\n                        className={`font-semibold ${\n                          entry.status === \'BLOCKED\'\n                            ? \'text-rose-600 dark:text-rose-400\'\n                            : entry.status === \'BYPASSED\'\n                            ? \'text-amber-500\'\n                            : \'text-emerald-600 dark:text-emerald-400\'\n                        }`}\n                      >\n                        {entry.resolvedIp}\n                      </span>\n                      <p className=\"text-[11px] text-slate-400\">\n                        {entry.latencyMs} ms\n                      </p>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            {/* Export Hosts & Native Kotlin Code Card */}\n            <div className=\"rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <h3 className=\"text-sm font-bold text-slate-900 dark:text-white font-display\">\n                  C\341\272\245u h\303\254nh Hosts & Kotlin VpnService\n                </h3>\n                <span className=\"text-xs font-mono text-slate-500\">\n                  \304\220\341\273\223ng b\341\273\231 t\341\273\261 \304\221\341\273\231ng\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-600 dark:text-slate-400 leading-relaxed\">\n                Xu\341\272\245t danh s\303\241ch ch\341\272\267n \304\221\341\273\213nh d\341\272\241ng <code className=\"font-mono\">0.0.0.0</code> ho\341\272\267c l\341\272\245y tr\341\273\215n b\341\273\231 m\303\243 ngu\341\273\223n Kotlin <code className=\"font-mono\">MiGuardVpnService.kt</code> (k\303\250m c\306\241 ch\341\272\277 t\341\273\261 x\303\263a log sau {logRetentionDays} ng\303\240y).\n              </p>\n              <div className=\"grid grid-cols-2 gap-2.5 pt-1\">\n                <button\n                  type=\"button\"\n                  onClick={() =>\n                    handleDownloadFile(\'miguard-hosts.txt\', generatedHostsContent)\n                  }\n                  className=\"min-h-[40px] px-3 py-2 rounded-lg text-xs font-medium border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center gap-1.5 whitespace-nowrap cursor-pointer\"\n                >\n                  <Download className=\"w-3.5 h-3.5\" />\n                  <span>T\341\272\243i file hosts</span>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setShowCodeModal(true)}\n                  className=\"min-h-[40px] px-3 py-2 rounded-lg text-xs font-medium bg-slate-900 dark:bg-white text-white dark:text-slate-950 hover:opacity-90 flex items-center justify-center gap-1.5 whitespace-nowrap cursor-pointer\"\n                >\n                  <Code2 className=\"w-3.5 h-3.5\" />\n                  <span>Xem code Kotlin</span>\n                </button>\n              </div>\n            </div>\n          </aside>\n        </div>\n      </main>\n\n      {/* MOBILE BOTTOM NAVIGATION BAR (Ergonomic Thumb Zone, <15% viewport height) */}\n      <nav\n        aria-label=\"\304\220i\341\273\201u h\306\260\341\273\233ng di \304\221\341\273\231ng\"\n        className=\"md:hidden fixed bottom-0 left-0 right-0 z-40 h-16 bg-white/95 dark:bg-slate-950/95 backdrop-blur-md border-t border-slate-200 dark:border-slate-800 grid grid-cols-4 items-center px-2\"\n      >\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'dashboard\')}\n          className={`min-h-[48px] flex flex-col items-center justify-center rounded-xl transition-colors cursor-pointer ${\n            activeTab === \'dashboard\'\n              ? \'text-emerald-600 dark:text-emerald-400\'\n              : \'text-slate-500 dark:text-slate-400\'\n          }`}\n        >\n          <Shield className=\"w-5 h-5\" />\n          <span className=\"text-[11px] font-medium mt-1 whitespace-nowrap\">\n            \304\220i\341\273\201u khi\341\273\203n\n          </span>\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'logs\')}\n          className={`min-h-[48px] flex flex-col items-center justify-center rounded-xl transition-colors cursor-pointer ${\n            activeTab === \'logs\'\n              ? \'text-emerald-600 dark:text-emerald-400\'\n              : \'text-slate-500 dark:text-slate-400\'\n          }`}\n        >\n          <Activity className=\"w-5 h-5\" />\n          <span className=\"text-[11px] font-medium mt-1 whitespace-nowrap\">\n            Nh\341\272\255t k\303\275\n          </span>\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'blocklist\')}\n          className={`min-h-[48px] flex flex-col items-center justify-center rounded-xl transition-colors cursor-pointer ${\n            activeTab === \'blocklist\'\n              ? \'text-emerald-600 dark:text-emerald-400\'\n              : \'text-slate-500 dark:text-slate-400\'\n          }`}\n        >\n          <Filter className=\"w-5 h-5\" />\n          <span className=\"text-[11px] font-medium mt-1 whitespace-nowrap\">\n            Danh s\303\241ch ch\341\272\267n\n          </span>\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'packages\')}\n          className={`min-h-[48px] flex flex-col items-center justify-center rounded-xl transition-colors cursor-pointer ${\n            activeTab === \'packages\'\n              ? \'text-emerald-600 dark:text-emerald-400\'\n              : \'text-slate-500 dark:text-slate-400\'\n          }`}\n        >\n          <Layers className=\"w-5 h-5\" />\n          <span className=\"text-[11px] font-medium mt-1 whitespace-nowrap\">\n            G\303\263i h\341\273\207 th\341\273\221ng\n          </span>\n        </button>\n      </nav>\n\n      {/* MODAL: DYNAMIC ANDROID KOTLIN VPNSERVICE SOURCE CODE & HOSTS EXPORT */}\n      {showCodeModal && (\n        <div className=\"fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4\">\n          <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-4xl w-full max-h-[88vh] flex flex-col overflow-hidden shadow-2xl\">\n            <div className=\"px-6 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between gap-4\">\n              <div>\n                <h2 className=\"text-base font-bold text-slate-900 dark:text-white font-display\">\n                  M\303\243 ngu\341\273\223n Android VPN & C\341\272\245u h\303\254nh Hosts (T\341\273\261 \304\221\341\273\231ng \304\221\341\273\223ng b\341\273\231)\n                </h2>\n                <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n                  \304\220\303\243 nh\303\272ng {stats.enabledRulesCount} domain ch\341\272\267n (0.0.0.0), DNS {primaryDns}, t\341\273\261 x\303\263a log sau {logRetentionDays} ng\303\240y v\303\240 {stats.selectedPackagesCount} package h\341\273\207 th\341\273\221ng.\n                </p>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => setShowCodeModal(false)}\n                aria-label=\"\304\220\303\263ng c\341\273\255a s\341\273\225 m\303\243 ngu\341\273\223n\"\n                className=\"min-h-[40px] min-w-[40px] rounded-lg flex items-center justify-center text-slate-500 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            <div className=\"px-6 py-3 bg-slate-50 dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3\">\n              <div className=\"flex items-center gap-1 p-1 bg-slate-200/70 dark:bg-slate-900 rounded-lg\">\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveCodeTab(\'kotlin\')}\n                  className={`px-3 py-1.5 text-xs font-mono font-medium rounded-md transition-colors cursor-pointer ${\n                    activeCodeTab === \'kotlin\'\n                      ? \'bg-white dark:bg-slate-800 text-slate-900 dark:text-emerald-400 shadow-xs\'\n                      : \'text-slate-600 dark:text-slate-400\'\n                  }`}\n                >\n                  MiGuardVpnService.kt\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveCodeTab(\'hosts\')}\n                  className={`px-3 py-1.5 text-xs font-mono font-medium rounded-md transition-colors cursor-pointer ${\n                    activeCodeTab === \'hosts\'\n                      ? \'bg-white dark:bg-slate-800 text-slate-900 dark:text-emerald-400 shadow-xs\'\n                      : \'text-slate-600 dark:text-slate-400\'\n                  }`}\n                >\n                  hosts.txt (0.0.0.0)\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveCodeTab(\'manifest\')}\n                  className={`px-3 py-1.5 text-xs font-mono font-medium rounded-md transition-colors cursor-pointer ${\n                    activeCodeTab === \'manifest\'\n                      ? \'bg-white dark:bg-slate-800 text-slate-900 dark:text-emerald-400 shadow-xs\'\n                      : \'text-slate-600 dark:text-slate-400\'\n                  }`}\n                >\n                  AndroidManifest.xml\n                </button>\n              </div>\n\n              <div className=\"flex items-center gap-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    const content =\n                      activeCodeTab === \'kotlin\'\n                        ? generatedKotlinCode\n                        : activeCodeTab === \'hosts\'\n                        ? generatedHostsContent\n                        : generatedManifestXml;\n                    handleCopyText(content, activeCodeTab);\n                  }}\n                  className=\"min-h-[36px] px-3 py-1.5 rounded-lg text-xs font-medium bg-emerald-600 hover:bg-emerald-500 text-white flex items-center gap-1.5 cursor-pointer\"\n                >\n                  {copiedFeedback === activeCodeTab ? (\n                    <>\n                      <Check className=\"w-3.5 h-3.5\" />\n                      <span>\304\220\303\243 sao ch\303\251p</span>\n                    </>\n                  ) : (\n                    <>\n                      <Copy className=\"w-3.5 h-3.5\" />\n                      <span>Sao ch\303\251p m\303\243</span>\n                    </>\n                  )}\n                </button>\n              </div>\n            </div>\n\n            <div className=\"flex-1 overflow-y-auto p-6 bg-slate-950 text-slate-100 font-mono text-xs leading-relaxed\">\n              <pre className=\"whitespace-pre-wrap break-words\">\n                {activeCodeTab === \'kotlin\'\n                  ? generatedKotlinCode\n                  : activeCodeTab === \'hosts\'\n                  ? generatedHostsContent\n                  : generatedManifestXml}\n              </pre>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n"
