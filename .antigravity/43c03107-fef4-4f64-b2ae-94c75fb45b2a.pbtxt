-artifact@v4\n        with:\n          name: MiGuard-DNS-APK\n          path: android/app/build/outputs/apk/debug/app-debug.apk`;\n}\n\nexport function generateFullAndroidSetupScript(\n  rules: DomainRule[],\n  upstreamDns: DnsUpstream,\n  secondaryDns: DnsUpstream,\n  filterMode: AppFilterMode,\n  packages: SystemPackageItem[],\n  logRetentionDays: LogRetentionDays\n): string {\n  const vpnServiceKt = generateKotlinVpnServiceCode(\n    rules,\n    upstreamDns,\n    secondaryDns,\n    filterMode,\n    packages,\n    logRetentionDays\n  );\n  const packetHelperKt = generateDnsPacketHelperCode();\n  const manifestXml = generateAndroidManifestXml();\n  const appGradle = generateAppBuildGradleKts();\n  const workflowYml = generateGitHubActionsApkYaml();\n\n  return `#!/usr/bin/env bash\n# Script t\341\273\261 \304\221\341\273\231ng t\341\272\241o tr\341\273\215n b\341\273\231 th\306\260 m\341\273\245c d\341\273\261 \303\241n Android MiGuard DNS k\303\250m c\341\272\245u h\303\254nh hi\341\273\207n t\341\272\241i c\341\273\247a b\341\272\241n\nset -e\n\nmkdir -p MiGuardDNS/android/app/src/main/java/com/miguard/dns/vpn\nmkdir -p MiGuardDNS/.github/workflows\n\ncat << \'EOF\' > MiGuardDNS/android/settings.gradle.kts\npluginManagement {\n    repositories {\n        google()\n        mavenCentral()\n        gradlePluginPortal()\n    }\n}\ndependencyResolutionManagement {\n    repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)\n    repositories {\n        google()\n        mavenCentral()\n    }\n}\nrootProject.name = \"MiGuardDNS\"\ninclude(\":app\")\nEOF\n\ncat << \'EOF\' > MiGuardDNS/android/build.gradle.kts\nplugins {\n    id(\"com.android.application\") version \"8.5.2\" apply false\n    id(\"org.jetbrains.kotlin.android\") version \"1.9.24\" apply false\n}\nEOF\n\ncat << \'EOF\' > MiGuardDNS/android/app/build.gradle.kts\n${appGradle}\nEOF\n\ncat << \'EOF\' > MiGuardDNS/android/app/src/main/AndroidManifest.xml\n${manifestXml}\nEOF\n\ncat << \'EOF\' > MiGuardDNS/android/app/src/main/java/com/miguard/dns/vpn/DnsPacketHelper.kt\n${packetHelperKt}\nEOF\n\ncat << \'EOF\' > MiGuardDNS/android/app/src/main/java/com/miguard/dns/vpn/MiGuardVpnService.kt\n${vpnServiceKt}\nEOF\n\ncat << \'EOF\' > MiGuardDNS/.github/workflows/build-apk.yml\n${workflowYml}\nEOF\n\necho \"\304\220\303\243 t\341\272\241o xong d\341\273\261 \303\241n Android t\341\272\241i ./MiGuardDNS!\"\necho \"1. M\341\273\237 th\306\260 m\341\273\245c MiGuardDNS/android b\341\272\261ng Android Studio -> Ch\341\273\215n Build > Build APK(s)\"\necho \"2. Ho\341\272\267c \304\221\341\272\251y l\303\252n GitHub \304\221\341\273\203 GitHub Actions t\341\273\261 \304\221\341\273\231ng bi\303\252n d\341\273\213ch file MiGuard-DNS-APK.apk\"\n`;\n}\n"
