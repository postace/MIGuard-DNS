            lines {
              text: "## 3. Key Product Decisions & Trade-Offs"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Quy\341\272\277t \304\221\341\273\213nh 1: Ki\341\272\277n tr\303\272c Local VPN DNS Interceptor thay v\303\254 Proxy to\303\240n ph\341\272\247n**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Gi\341\272\243i ph\303\241p ch\341\273\215n*: Ch\341\273\211 \304\221\341\273\213nh tuy\341\272\277n l\306\260u l\306\260\341\273\243ng truy v\341\272\245n DNS (c\341\273\225ng UDP 53) qua giao di\341\273\207n TUN \341\272\243o c\341\273\247a Android `VpnService`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *L\303\275 do*: Gi\303\272p \341\273\251ng d\341\273\245ng c\341\273\261c k\341\273\263 nh\341\273\217 nh\341\272\271, kh\303\264ng l\303\240m ch\341\272\255m t\341\273\221c \304\221\341\273\231 t\341\272\243i d\341\273\257 li\341\273\207u hay ch\306\241i game, \304\221\341\273\223ng th\341\273\235i kh\303\264ng ti\303\252u t\341\273\221n pin khi ch\341\272\241y ng\341\272\247m 24/7."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Quy\341\272\277t \304\221\341\273\213nh 2: H\341\273\227 tr\341\273\243 k\303\251p hai ch\341\272\277 \304\221\341\273\231 Per-App VPN (`Allowed` vs `Disallowed`)**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Gi\341\272\243i ph\303\241p ch\341\273\215n*: Cung c\341\272\245p c\303\264ng t\341\272\257c chuy\341\273\203n \304\221\341\273\225i tr\341\273\261c ti\341\272\277p gi\341\273\257a `Builder.addAllowedApplication()` v\303\240 `Builder.addDisallowedApplication()`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *L\303\275 do*: Khi ng\306\260\341\273\235i d\303\271ng ch\341\273\211 mu\341\273\221n kh\303\263a k\341\272\277t n\341\273\221i c\341\273\247a c\303\241c app h\341\273\207 th\341\273\221ng MIUI m\303\240 kh\303\264ng mu\341\273\221n ch\341\272\241m v\303\240o c\303\241c \341\273\251ng d\341\273\245ng ng\303\242n h\303\240ng hay game, ch\341\272\277 \304\221\341\273\231 *Ch\341\273\211 l\341\273\215c package \304\221\306\260\341\273\243c ch\341\273\215n* mang l\341\272\241i s\341\273\261 an t\303\242m tuy\341\273\207t \304\221\341\273\221i."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Quy\341\272\277t \304\221\341\273\213nh 3: K\341\272\277t h\341\273\243p Tr\303\254nh m\303\264 ph\341\273\217ng Th\341\273\235i gian th\341\273\261c + Tr\303\254nh sinh M\303\243 ngu\341\273\223n Kotlin \304\220\341\273\231ng**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Gi\341\272\243i ph\303\241p ch\341\273\215n*: M\341\273\215i thay \304\221\341\273\225i v\341\273\201 danh s\303\241ch domain ch\341\272\267n, DNS `1.1.1.1`/`8.8.8.8`, v\303\240 danh s\303\241ch package h\341\273\207 th\341\273\221ng tr\303\252n giao di\341\273\207n \304\221\341\273\201u \304\221\341\273\223ng b\341\273\231 tr\341\273\261c ti\341\272\277p v\303\240o lu\341\273\223ng m\303\264 ph\341\273\217ng g\303\263i tin DNS l\341\272\253n m\303\243 ngu\341\273\223n Kotlin `VpnService` xu\341\272\245t ra."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *L\303\275 do*: Gi\303\272p ng\306\260\341\273\235i d\303\271ng ki\341\273\203m th\341\273\255 ngay h\303\240nh vi ch\341\272\267n/m\341\273\237 tr\303\252n giao di\341\273\207n v\303\240 c\303\263 ngay file code Android \304\221\303\243 nh\303\272ng s\341\272\265n c\341\272\245u h\303\254nh c\303\241 nh\303\242n h\303\263a c\341\273\247a m\303\254nh."
