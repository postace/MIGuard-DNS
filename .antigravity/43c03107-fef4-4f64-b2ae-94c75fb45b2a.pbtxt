      id: "call_112497"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { AppFilterMode, DnsUpstream, DomainRule, SystemPackageItem } from \'../data/vpnDefaults\';\\n\\nexport function generateHostsFileContent(rules: DomainRule[]): string {\\n  const activeRules = rules.filter((r) => r.enabled);\\n  const header = [\\n    \'# MiGuard DNS \342\200\224 Local Sinkhole Hosts Configuration\',\\n    `# Active Blocked Domains: ${activeRules.length}`,\\n    \'# Target Sinkhole Address: 0.0.0.0\',\\n    \'\',\\n  ];\\n  const lines = activeRules.map((r) => `0.0.0.0 ${r.domain}`);\\n  return [...header, ...lines].join(\'\\\\n\');\\n}\\n\\nexport function generateKotlinVpnServiceCode(\\n  rules: DomainRule[],\\n  upstreamDns: DnsUpstream,\\n  secondaryDns: DnsUpstream,\\n  filterMode: AppFilterMode,\\n  packages: SystemPackageItem[]\\n): string {\\n  const activeDomains = rules.filter((r) => r.enabled).map((r) => `        \\\"${r.domain}\\\"`);\\n  const selectedPackages = packages.filter((p) => p.selected).map((p) => `        \\\"${p.packageName}\\\"`);\\n\\n  const perAppCodeBlock =\\n    filterMode === \'allowlist\'\\n      ? `        // Ch\341\272\277 \304\221\341\273\231: Ch\341\273\211 l\341\273\215c DNS cho c\303\241c package h\341\273\207 th\341\273\221ng \304\221\306\260\341\273\243c ch\341\273\215n\\n        targetPackages.forEach { pkg ->\\n            try {\\n                builder.addAllowedApplication(pkg)\\n            } catch (e: PackageManager.NameNotFoundException) {\\n                // B\341\273\217 qua n\341\272\277u thi\341\272\277t b\341\273\213 kh\303\264ng c\303\240i s\341\272\265n package n\303\240y\\n            }\\n        }`\\n      : `        // Ch\341\272\277 \304\221\341\273\231: L\341\273\215c to\303\240n thi\341\272\277t b\341\273\213 v\303\240 lo\341\272\241i tr\341\273\253 c\303\241c package \304\221\306\260\341\273\243c ch\341\273\215n\\n        targetPackages.forEach { pkg ->\\n            try {\\n                builder.addDisallowedApplication(pkg)\\n            } catch (e: PackageManager.NameNotFoundException) {\\n                // B\341\273\217 qua n\341\272\277u thi\341\272\277t b\341\273\213 kh\303\264ng c\303\240i s\341\272\265n package n\303\240y\\n            }\\n        }`;\\n\\n  return `package com.miguard.dns.vpn\\n\\nimport android.content.Intent\\nimport android.content.pm.PackageManager\\nimport android.net.VpnService\\nimport android.os.ParcelFileDescriptor\\nimport java.io.FileInputStream\\nimport java.io.FileOutputStream\\nimport java.net.DatagramPacket\\nimport java.net.DatagramSocket\\nimport java.net.InetAddress\\nimport java.nio.ByteBuffer\\nimport kotlin.concurrent.thread\\n\\n/**\\n * MiGuardVpnService \342\200\224 D\341\273\213ch v\341\273\245 Android VPN c\341\273\245c b\341\273\231 nh\341\272\271\\n * Ch\341\272\267n c\303\241c domain telemetry Xiaomi/MIUI v\341\273\201 0.0.0.0\\n * v\303\240 chuy\341\273\203n ti\341\272\277p c\303\241c truy v\341\272\245n h\341\273\243p l\341\273\207 ra DNS ${upstreamDns} / ${secondaryDns}\\n */\\nclass MiGuardVpnService : VpnService() {\\n\\n    private var vpnInterface: ParcelFileDescriptor? = null\\n    @Volatile private var isRunning = false\\n\\n    companion object {\\n        const val PRIMARY_DNS = \\\"${upstreamDns}\\\"\\n        const val SECONDARY_DNS = \\\"${secondaryDns}\\\"\\n        const val VIRTUAL_TUN_IP = \\\"10.111.222.1\\\"\\n    }\\n\\n    // Danh s\303\241ch t\303\252n mi\341\273\201n b\341\273\213 ch\341\272\267n v\341\273\201 0.0.0.0\\n    private val blockedDomains = hashSetOf(\\n${activeDomains.join(\',\\\\n\')}\\n    )\\n\\n    // Danh s\303\241ch package h\341\273\207 th\341\273\221ng \303\241p d\341\273\245ng b\341\273\231 l\341\273\215c Per-App VPN\\n    private val targetPackages = listOf(\\n${selectedPackages.join(\',\\\\n\')}\\n    )\\n\\n    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {\\n        if (!isRunning) {\\n            isRunning = true\\n            startDnsTunnel()\\n        }\\n        return START_STICKY\\n    }\\n\\n    private fun startDnsTunnel() {\\n        val builder = Builder()\\n            .setSession(\\\"MiGuard DNS Filter\\\")\\n            .setMtu(1500)\\n            .addAddress(VIRTUAL_TUN_IP, 24)\\n            .addDnsServer(PRIMARY_DNS)\\n            .addDnsServer(SECONDARY_DNS)\\n            // Ch\341\273\211 \304\221\341\273\213nh tuy\341\272\277n l\306\260u l\306\260\341\273\243ng t\341\273\233i m\303\241y ch\341\273\247 DNS qua TUN \304\221\341\273\203 ti\341\272\277t ki\341\273\207m pin t\341\273\221i \304\221a\\n            .addRoute(PRIMARY_DNS, 32)\\n            .addRoute(SECONDARY_DNS, 32)\\n\\n${perAppCodeBlock}\\n\\n        vpnInterface = builder.establish() ?: return\\n\\n        thread(name = \\\"MiGuard-DnsLoop\\\", isDaemon = true) {\\n            val fd = vpnInterface?.fileDescriptor ?: return@thread\\n            val input = FileInputStream(fd)\\n            val output = FileOutputStream(fd)\\n            val packet = ByteArray(1500)\\n\\n            while (isRunning) {\\n                val length = input.read(packet)\\n                if (length > 0) {\\n                    handleIpPacket(packet, length, output)\\n                }\\n            }\\n        }\\n    }\\n\\n    private fun handleIpPacket(rawPacket: ByteArray, length: Int, tunOutput: FileOutputStream) {\\n        val qName = DnsPacketHelper.extractDomainName(rawPacket, length) ?: return\\n        val normalizedDomain = qName.lowercase()\\n\\n        if (shouldBlock(normalizedDomain)) {\\n            // Tr\341\272\243 v\341\273\201 ngay b\341\272\243n ghi A = 0.0.0.0 (Sinkhole) kh\303\264ng c\341\272\247n ra m\341\272\241ng\\n            val sinkholeResponse = DnsPacketHelper.buildSinkholeResponse(rawPacket, length)\\n            tunOutput.write(sinkholeResponse)\\n        } else {\\n            // Chuy\341\273\203n ti\341\272\277p ra DNS ${upstreamDns} qua socket \304\221\306\260\341\273\243c b\341\272\243o v\341\273\207 (protect)\\n            forwardToUpstreamDns(rawPacket, length, tunOutput)\\n        }\\n    }\\n\\n    private fun shouldBlock(domain: String): Boolean {\\n        if (blockedDomains.contains(domain)) return true\\n        return blockedDomains.any { blocked -> domain.endsWith(\\\".\\\\$blocked\\\") }\\n    }\\n\\n    private fun forwardToUpstreamDns(rawPacket: ByteArray, length: Int, tunOutput: FileOutputStream) {\\n        DatagramSocket().use { socket ->\\n            protect(socket) // Tr\303\241nh v\303\262ng l\341\272\267p qua ch\303\255nh VPN\\n            socket.soTimeout = 3000\\n            val dnsPayload = DnsPacketHelper.extractUdpPayload(rawPacket, length)\\n            val upstreamAddr = InetAddress.getByName(PRIMARY_DNS)\\n            socket.send(DatagramPacket(dnsPayload, dnsPayload.size, upstreamAddr, 53))\\n\\n            val respBuf = ByteArray(1500)\\n            val respPacket = DatagramPacket(respBuf, respBuf.size)\\n            socket.receive(respPacket)\\n\\n            val wrappedIpPacket = DnsPacketHelper.wrapUdpResponse(\\n                originalRequest = rawPacket,\\n                dnsResponse = respBuf,\\n                dnsLength = respPacket.length\\n            )\\n            tunOutput.write(wrappedIpPacket)\\n        }\\n    }\\n\\n    override fun onDestroy() {\\n        isRunning = false\\n        vpnInterface?.close()\\n        vpnInterface = null\\n        super.onDestroy()\\n    }\\n}`;\\n}\\n\\nexport function generateAndroidManifestXml(): string {\\n  return `<?xml version=\\\"1.0\\\" encoding=\\\"utf-8\\\"?>\\n<manifest xmlns:android=\\\"http://schemas.android.com/apk/res/android\\\"\\n    package=\\\"com.miguard.dns\\\">\\n\\n    <uses-permission android:name=\\\"android.permission.FOREGROUND_SERVICE\\\" />\\n    <uses-permission android:name=\\\"android.permission.INTERNET\\\" />\\n    <uses-permission android:name=\\\"android.permission.QUERY_ALL_PACKAGES\\\" />\\n\\n    <application\\n        android:label=\\\"MiGuard DNS\\\"\\n        android:allowBackup=\\\"true\\\"\\n        android:supportsRtl=\\\"true\\\">\\n\\n        <service\\n            android:name=\\\".vpn.MiGuardVpnService\\\"\\n            android:exported=\\\"true\\\"\\n            android:permission=\\\"android.permission.BIND_VPN_SERVICE\\\">\\n            <intent-filter>\\n                <action android:name=\\\"android.net.VpnService\\\" />\\n            </intent-filter>\\n        </service>\\n    </application>\\n</manifest>`;\\n}\\n\",\"Description\":\"Create Kotlin VpnService and hosts generator utilities\",\"Overwrite\":true,\"TargetFile\":\"/src/utils/kotlinGenerator.ts\",\"toolAction\":\"Creating Kotlin code generator\",\"toolSummary\":\"Create Kotlin VpnService and hosts configuration generator\"}"
      original_name: "write_to_file"
    }
