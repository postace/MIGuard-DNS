      id: "call_464574"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"package com.miguard.dns\\n\\nimport android.app.Activity\\nimport android.content.Intent\\nimport android.net.VpnService\\nimport android.os.Bundle\\nimport androidx.activity.ComponentActivity\\nimport androidx.activity.compose.rememberLauncherForActivityResult\\nimport androidx.activity.compose.setContent\\nimport androidx.activity.result.contract.ActivityResultContracts\\nimport androidx.compose.foundation.background\\nimport androidx.compose.foundation.clickable\\nimport androidx.compose.foundation.layout.*\\nimport androidx.compose.foundation.lazy.LazyColumn\\nimport androidx.compose.foundation.lazy.items\\nimport androidx.compose.foundation.shape.RoundedCornerShape\\nimport androidx.compose.material3.*\\nimport androidx.compose.runtime.*\\nimport androidx.compose.ui.Alignment\\nimport androidx.compose.ui.Modifier\\nimport androidx.compose.ui.graphics.Color\\nimport androidx.compose.ui.platform.LocalContext\\nimport androidx.compose.ui.text.font.FontFamily\\nimport androidx.compose.ui.text.font.FontWeight\\nimport androidx.compose.ui.unit.dp\\nimport androidx.compose.ui.unit.sp\\nimport com.miguard.dns.data.PerAppMode\\nimport com.miguard.dns.data.VpnRepository\\nimport com.miguard.dns.vpn.MiGuardVpnService\\nimport java.text.SimpleDateFormat\\nimport java.util.Date\\nimport java.util.Locale\\n\\nclass MainActivity : ComponentActivity() {\\n    override fun onCreate(savedInstanceState: Bundle?) {\\n        super.onCreate(savedInstanceState)\\n        setContent {\\n            MaterialTheme(\\n                colorScheme = darkColorScheme(\\n                    primary = Color(0xFF10B981),\\n                    background = Color(0xFF090D16),\\n                    surface = Color(0xFF111827)\\n                )\\n            ) {\\n                MiGuardAppScreen()\\n            }\\n        }\\n    }\\n}\\n\\n@Composable\\nfun MiGuardAppScreen() {\\n    val context = LocalContext.current\\n    val isRunning by VpnRepository.vpnRunning.collectAsState()\\n    val primaryDns by VpnRepository.primaryDns.collectAsState()\\n    val retentionDays by VpnRepository.retentionDays.collectAsState()\\n    val perAppMode by VpnRepository.perAppMode.collectAsState()\\n    val rules by VpnRepository.rules.collectAsState()\\n    val selectedPackages by VpnRepository.selectedPackages.collectAsState()\\n    val logs by VpnRepository.logs.collectAsState()\\n\\n    var currentTab by remember { mutableStateOf(0) }\\n    var customDomainText by remember { mutableStateOf(\\\"\\\") }\\n\\n    val vpnPermissionLauncher = rememberLauncherForActivityResult(\\n        contract = ActivityResultContracts.StartActivityForResult()\\n    ) { result ->\\n        if (result.resultCode == Activity.RESULT_OK) {\\n            val intent = Intent(context, MiGuardVpnService::class.java).apply {\\n                action = MiGuardVpnService.ACTION_START\\n            }\\n            context.startService(intent)\\n        }\\n    }\\n\\n    fun toggleVpn() {\\n        if (isRunning) {\\n            val stopIntent = Intent(context, MiGuardVpnService::class.java).apply {\\n                action = MiGuardVpnService.ACTION_STOP\\n            }\\n            context.startService(stopIntent)\\n        } else {\\n            val prepareIntent = VpnService.prepare(context)\\n            if (prepareIntent != null) {\\n                vpnPermissionLauncher.launch(prepareIntent)\\n            } else {\\n                val startIntent = Intent(context, MiGuardVpnService::class.java).apply {\\n                    action = MiGuardVpnService.ACTION_START\\n                }\\n                context.startService(startIntent)\\n            }\\n        }\\n    }\\n\\n    Scaffold(\\n        containerColor = Color(0xFF090D16),\\n        bottomBar = {\\n            NavigationBar(containerColor = Color(0xFF111827)) {\\n                listOf(\\\"\304\220i\341\273\201u khi\341\273\203n\\\", \\\"Nh\341\272\255t k\303\275\\\", \\\"Danh s\303\241ch ch\341\272\267n\\\", \\\"G\303\263i h\341\273\207 th\341\273\221ng\\\").forEachIndexed { idx, title ->\\n                    NavigationBarItem(\\n                        selected = currentTab == idx,\\n                        onClick = { currentTab = idx },\\n                        icon = {},\\n                        label = { Text(title, fontSize = 12.sp) }\\n                    )\\n                }\\n            }\\n        }\\n    ) { innerPadding ->\\n        Column(\\n            modifier = Modifier\\n                .fillMaxSize()\\n                .padding(innerPadding)\\n                .padding(16.dp),\\n            verticalArrangement = Arrangement.spacedBy(16.dp)\\n        ) {\\n            when (currentTab) {\\n                0 -> {\\n                    // M\303\240n h\303\254nh ch\303\255nh: B\341\272\255t/T\341\272\257t VPN + Ch\341\273\215n DNS 1.1.1.1 / 8.8.8.8 + Th\341\273\221ng k\303\252\\n                    Surface(\\n                        shape = RoundedCornerShape(16.dp),\\n                        color = Color(0xFF111827),\\n                        modifier = Modifier.fillMaxWidth()\\n                    ) {\\n                        Column(modifier = Modifier.padding(20.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {\\n                            Text(\\n                                text = if (isRunning) \\\"\304\220ang b\341\272\243o v\341\273\207 (TUN 10.111.222.1)\\\" else \\\"VPN \304\221ang t\341\272\257t\\\",\\n                                color = if (isRunning) Color(0xFF10B981) else Color.Gray,\\n                                fontSize = 13.sp,\\n                                fontFamily = FontFamily.Monospace\\n                            )\\n                            Text(\\n                                text = if (isRunning) \\\"\304\220ang ch\341\272\267n Telemetry Xiaomi/MIUI\\\" else \\\"Ch\341\272\241m \304\221\341\273\203 k\303\255ch ho\341\272\241t l\341\273\215c DNS\\\",\\n                                color = Color.White,\\n                                fontSize = 20.sp,\\n                                fontWeight = FontWeight.Bold\\n                            )\\n                            Button(\\n                                onClick = { toggleVpn() },\\n                                colors = ButtonDefaults.buttonColors(\\n                                    containerColor = if (isRunning) Color(0xFFE11D48) else Color(0xFF10B981)\\n                                ),\\n                                modifier = Modifier.fillMaxWidth().height(50.dp)\\n                            ) {\\n                                Text(if (isRunning) \\\"Ng\341\272\257t k\341\272\277t n\341\273\221i VPN\\\" else \\\"B\341\272\255t b\341\272\243o v\341\273\207 DNS\\\")\\n                            }\\n                        }\\n                    }\\n\\n                    Row(horizontalArrangement = Arrangement.spacedBy(12.dp), modifier = Modifier.fillMaxWidth()) {\\n                        listOf(\\\"1.1.1.1\\\", \\\"8.8.8.8\\\").forEach { dns ->\\n                            OutlinedButton(\\n                                onClick = { VpnRepository.setPrimaryDns(dns) },\\n                                modifier = Modifier.weight(1f),\\n                                colors = ButtonDefaults.outlinedButtonColors(\\n                                    containerColor = if (primaryDns == dns) Color(0xFF10B981).copy(alpha = 0.15f) else Color.Transparent\\n                                )\\n                            ) {\\n                                Text(\\\"DNS $dns\\\", color = Color.White, fontFamily = FontFamily.Monospace)\\n                            }\\n                        }\\n                    }\\n\\n                    val totalBlocked = rules.sumOf { it.hitCount }\\n                    Text(\\n                        text = \\\"\304\220\303\243 ch\341\272\267n v\341\273\201 0.0.0.0: $totalBlocked request \302\267 Chu k\341\273\263 x\303\263a log: $retentionDays ng\303\240y\\\",\\n                        color = Color.LightGray,\\n                        fontSize = 13.sp,\\n                        fontFamily = FontFamily.Monospace\\n                    )\\n                }\\n\\n                1 -> {\\n                    // M\303\240n h\303\254nh Nh\341\272\255t k\303\275 th\341\273\235i gian th\341\273\261c & T\341\273\261 x\303\263a log (M\341\272\267c \304\221\341\273\213nh 7 ng\303\240y)\\n                    Text(\\\"T\341\273\261 \304\221\341\273\231ng x\303\263a log k\341\272\277t n\341\273\221i sau:\\\", color = Color.White, fontWeight = FontWeight.SemiBold)\\n                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {\\n                        listOf(1L, 3L, 7L, 14L, 30L).forEach { dayOption ->\\n                            FilterChip(\\n                                selected = retentionDays == dayOption,\\n                                onClick = { VpnRepository.setRetentionDays(dayOption) },\\n                                label = { Text(if (dayOption == 7L) \\\"7 ng\303\240y (M\341\272\267c \304\221\341\273\213nh)\\\" else \\\"$dayOption ng\303\240y\\\") }\\n                            )\\n                        }\\n                    }\\n\\n                    val sdf = remember { SimpleDateFormat(\\\"HH:mm:ss\\\", Locale.getDefault()) }\\n                    LazyColumn(verticalArrangement = Arrangement.spacedBy(8.dp)) {\\n                        items(logs, key = { it.id }) { item ->\\n                            Surface(\\n                                shape = RoundedCornerShape(12.dp),\\n                                color = Color(0xFF111827),\\n                                modifier = Modifier.fillMaxWidth()\\n                            ) {\\n                                Row(\\n                                    modifier = Modifier.padding(12.dp).fillMaxWidth(),\\n                                    horizontalArrangement = Arrangement.SpaceBetween,\\n                                    verticalAlignment = Alignment.CenterVertically\\n                                ) {\\n                                    Column(modifier = Modifier.weight(1f)) {\\n                                        Text(\\n                                            text = item.domain,\\n                                            color = if (item.blocked) Color(0xFFF43F5E) else Color.White,\\n                                            fontFamily = FontFamily.Monospace,\\n                                            fontSize = 13.sp\\n                                        )\\n                                        Text(\\n                                            text = \\\"${sdf.format(Date(item.timestampMs))} \302\267 ${item.latencyMs} ms\\\",\\n                                            color = Color.Gray,\\n                                            fontSize = 11.sp,\\n                                            fontFamily = FontFamily.Monospace\\n                                        )\\n                                    }\\n                                    Text(\\n                                        text = if (item.blocked) \\\"0.0.0.0\\\" else item.resolvedTarget,\\n                                        color = if (item.blocked) Color(0xFFF43F5E) else Color(0xFF10B981),\\n                                        fontFamily = FontFamily.Monospace,\\n                                        fontWeight = FontWeight.Bold,\\n                                        fontSize = 12.sp\\n                                    )\\n                                }\\n                            }\\n                        }\\n                    }\\n                }\\n\\n                2 -> {\\n                    // M\303\240n h\303\254nh Danh s\303\241ch ch\341\272\267n & G\341\273\243i \303\275 MIUI\\n                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp), verticalAlignment = Alignment.CenterVertically) {\\n                        OutlinedTextField(\\n                            value = customDomainText,\\n                            onValueChange = { customDomainText = it },\\n                            placeholder = { Text(\\\"0.0.0.0 domain.com\\\") },\\n                            modifier = Modifier.weight(1f),\\n                            singleLine = true\\n                        )\\n                        Button(onClick = {\\n                            VpnRepository.addOrEnableRule(customDomainText)\\n                            customDomainText = \\\"\\\"\\n                        }) {\\n                            Text(\\\"Th\303\252m\\\")\\n                        }\\n                    }\\n\\n                    LazyColumn(verticalArrangement = Arrangement.spacedBy(8.dp)) {\\n                        items(rules, key = { it.domain }) { rule ->\\n                            Surface(\\n                                shape = RoundedCornerShape(12.dp),\\n                                color = Color(0xFF111827),\\n                                modifier = Modifier.fillMaxWidth()\\n                            ) {\\n                                Row(\\n                                    modifier = Modifier.padding(12.dp).fillMaxWidth(),\\n                                    horizontalArrangement = Arrangement.SpaceBetween,\\n                                    verticalAlignment = Alignment.CenterVertically\\n                                ) {\\n                                    Column(modifier = Modifier.weight(1f)) {\\n                                        Text(\\n                                            text = \\\"0.0.0.0 ${rule.domain}\\\",\\n                                            color = Color.White,\\n                                            fontFamily = FontFamily.Monospace,\\n                                            fontSize = 13.sp\\n                                        )\\n                                        Text(\\n                                            text = \\\"\304\220\303\243 ch\341\272\267n ${rule.hitCount} l\341\272\247n\\\",\\n                                            color = Color.Gray,\\n                                            fontSize = 11.sp\\n                                        )\\n                                    }\\n                                    Switch(\\n                                        checked = rule.enabled,\\n                                        onCheckedChange = { VpnRepository.toggleRule(rule.domain) }\\n                                    )\\n                                }\\n                            }\\n                        }\\n                    }\\n                }\\n\\n                3 -> {\\n                    // M\303\240n h\303\254nh ch\341\273\215n Package h\341\273\207 th\341\273\221ng (Per-App VPN)\\n                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {\\n                        FilterChip(\\n                            selected = perAppMode == PerAppMode.ALLOWLIST,\\n                            onClick = { VpnRepository.setPerAppMode(PerAppMode.ALLOWLIST) },\\n                            label = { Text(\\\"Ch\341\273\211 l\341\273\215c g\303\263i \304\221\303\243 ch\341\273\215n\\\") }\\n                        )\\n                        FilterChip(\\n                            selected = perAppMode == PerAppMode.BLOCKLIST,\\n                            onClick = { VpnRepository.setPerAppMode(PerAppMode.BLOCKLIST) },\\n                            label = { Text(\\\"L\341\273\215c to\303\240n m\303\241y & lo\341\272\241i tr\341\273\253\\\") }\\n                        )\\n                    }\\n\\n                    val systemPackages = listOf(\\n                        \\\"com.miui.securitycenter\\\",\\n                        \\\"com.miui.analytics\\\",\\n                        \\\"com.miui.daemon\\\",\\n                        \\\"com.miui.msa.global\\\",\\n                        \\\"com.xiaomi.joyose\\\",\\n                        \\\"com.xiaomi.finddevice\\\",\\n                        \\\"com.miui.guardprovider\\\"\\n                    )\\n\\n                    LazyColumn(verticalArrangement = Arrangement.spacedBy(8.dp)) {\\n                        items(systemPackages) { pkg ->\\n                            Surface(\\n                                shape = RoundedCornerShape(12.dp),\\n                                color = Color(0xFF111827),\\n                                modifier = Modifier.fillMaxWidth().clickable { VpnRepository.togglePackage(pkg) }\\n                            ) {\\n                                Row(\\n                                    modifier = Modifier.padding(12.dp).fillMaxWidth(),\\n                                    horizontalArrangement = Arrangement.SpaceBetween,\\n                                    verticalAlignment = Alignment.CenterVertically\\n                                ) {\\n                                    Text(pkg, color = Color.White, fontFamily = FontFamily.Monospace, fontSize = 13.sp)\\n                                    Checkbox(\\n                                        checked = selectedPackages.contains(pkg),\\n                                        onCheckedChange = { VpnRepository.togglePackage(pkg) }\\n                                    )\\n                                }\\n                            }\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n    }\\n}\\n\",\"Description\":\"Create MainActivity.kt with Jetpack Compose UI for MiGuard DNS Android application\",\"Overwrite\":true,\"TargetFile\":\"/android/app/src/main/java/com/miguard/dns/MainActivity.kt\",\"toolAction\":\"Creating MainActivity.kt\",\"toolSummary\":\"Create MainActivity.kt with Jetpack Compose screens\"}"
      original_name: "write_to_file"
