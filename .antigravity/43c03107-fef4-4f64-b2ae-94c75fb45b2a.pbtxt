            lines {
              text: "function formatRelativeAge(createdAt: number): string {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const diffMs = Math.max(0, Date.now() - createdAt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const diffDays = Math.floor(diffMs / DAY_MS);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (diffDays === 0) return \'H\303\264m nay\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (diffDays === 1) return \'1 ng\303\240y tr\306\260\341\273\233c\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return `${diffDays} ng\303\240y tr\306\260\341\273\233c`;"
