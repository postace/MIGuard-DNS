fact@v4\n        with:\n          name: MiGuard-DNS-APK\n          path: android/app/build/outputs/apk/debug/app-debug.apk`;\n}\n\nexport function generateFullAndroidSetupScript(\n  rules: DomainRule[],\n  upstreamDns: DnsUpstream,\n  secondaryDns: DnsUpstream,\n  filterMode: AppFilterMode,\n  packages: SystemPackageItem[],\n  logRetentionDays: LogRetentionDays\n): string {\n  const vpnServiceKt = generateKotlinVpnServiceCode(\n    rules,\n    upstreamDns,\n    secondaryDns,\n    filterMode,\n    packages,\n    logRetentionDays\n  );\n  const packetHelperKt = generateDnsPacketHelperCode();\n  const manifestXml = generateAndroidManifestXml();\n  const appGradle = generateAppBuildGradleKts();\n  const workflowYml = generateGitHubActionsApkYaml();\n\n  return `#!/usr/bin/env bash\n# Script t\341\273\261 \304\221\341\273\231ng t\341\272\241o tr\341\273\215n b\341\273\231 th\306\260 m\341\273\245c d\341\273\261 \303\241n Android MiGuard DNS k\303\250m c\341\272\245u h\303\254nh hi\341\273\207n t\341\272\241i c\341\273\247a b\341\272\241n\nset -e\n\nmkdir -p MiGuardDNS/android/app/src/main/java/com/miguard/dns/vpn\nmkdir -p MiGuardDNS/.github/workflows\n\ncat << \'EOF\' > MiGuardDNS/android/settings.gradle.kts\npluginManagement {\n    repositories {\n        google()\n        mavenCentral()\n        gradlePluginPortal()\n    }\n}\ndependencyResolutionManagement {\n    repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)\n    repositories {\n        google()\n        mavenCentral()\n    }\n}\nrootProject.name = \"MiGuardDNS\"\ninclude(\":app\")\nEOF\n\ncat << \'EOF\' > MiGuardDNS/android/build.gradle.kts\nplugins {\n    id(\"com.android.application\") version \"8.5.2\" apply false\n    id(\"org.jetbrains.kotlin.android\") version \"1.9.24\" apply false\n}\nEOF\n\ncat << \'EOF\' > MiGuardDNS/android/app/build.gradle.kts\n${appGradle}\nEOF\n\ncat << \'EOF\' > MiGuardDNS/android/app/src/main/AndroidManifest.xml\n${manifestXml}\nEOF\n\ncat << \'EOF\' > MiGuardDNS/android/app/src/main/java/com/miguard/dns/vpn/DnsPacketHelper.kt\n${packetHelperKt}\nEOF\n\ncat << \'EOF\' > MiGuardDNS/android/app/src/main/java/com/miguard/dns/vpn/MiGuardVpnService.kt\n${vpnServiceKt}\nEOF\n\ncat << \'EOF\' > MiGuardDNS/.github/workflows/build-apk.yml\n${workflowYml}\nEOF\n\necho \"\304\220\303\243 t\341\272\241o xong d\341\273\261 \303\241n Android t\341\272\241i ./MiGuardDNS!\"\necho \"1. M\341\273\237 th\306\260 m\341\273\245c MiGuardDNS/android b\341\272\261ng Android Studio -> Ch\341\273\215n Build > Build APK(s)\"\necho \"2. Ho\341\272\267c \304\221\341\272\251y l\303\252n GitHub \304\221\341\273\203 GitHub Actions t\341\273\261 \304\221\341\273\231ng bi\303\252n d\341\273\213ch file MiGuard-DNS-APK.apk\"\n`;\n}"
          replacement_content: "export function generateAppBuildGradleKts(): string {\n  return `plugins {\n    id(\"com.android.application\")\n    id(\"org.jetbrains.kotlin.android\")\n}\n\nandroid {\n    namespace = \"com.miguard.dns\"\n    compileSdk = 34\n\n    defaultConfig {\n        applicationId = \"com.miguard.dns\"\n        minSdk = 26\n        targetSdk = 34\n        versionCode = 1\n        versionName = \"1.0.0\"\n    }\n\n    signingConfigs {\n        create(\"release\") {\n            val keystoreFile = file(System.getenv(\"KEYSTORE_PATH\") ?: \"release-keystore.jks\")\n            if (keystoreFile.exists()) {\n                storeFile = keystoreFile\n                storePassword = System.getenv(\"KEYSTORE_PASSWORD\") ?: \"miguard_prod_2026\"\n                keyAlias = System.getenv(\"KEY_ALIAS\") ?: \"miguard_key\"\n                keyPassword = System.getenv(\"KEY_PASSWORD\") ?: \"miguard_prod_2026\"\n            } else {\n                val debugConfig = getByName(\"debug\")\n                storeFile = debugConfig.storeFile\n                storePassword = debugConfig.storePassword\n                keyAlias = debugConfig.keyAlias\n                keyPassword = debugConfig.keyPassword\n            }\n        }\n    }\n\n    buildTypes {\n        release {\n            // B\341\272\243n Production th\341\273\261c th\341\273\245: B\341\272\255t R8 thu g\341\273\215n code, x\303\263a t\303\240i nguy\303\252n th\341\273\253a v\303\240 k\303\275 s\341\273\221 APK\n            isMinifyEnabled = true\n            isShrinkResources = true\n            isDebuggable = false\n            signingConfig = signingConfigs.getByName(\"release\")\n            proguardFiles(\n                getDefaultProguardFile(\"proguard-android-optimize.txt\"),\n                \"proguard-rules.pro\"\n            )\n        }\n        debug {\n            applicationIdSuffix = \".debug\"\n            versionNameSuffix = \"-debug\"\n        }\n    }\n\n    compileOptions {\n        sourceCompatibility = JavaVersion.VERSION_17\n        targetCompatibility = JavaVersion.VERSION_17\n    }\n\n    kotlinOptions {\n        jvmTarget = \"17\"\n    }\n\n    buildFeatures {\n        compose = true\n    }\n\n    composeOptions {\n        kotlinCompilerExtensionVersion = \"1.5.14\"\n    }\n\n    packaging {\n        resources {\n            excludes += \"/META-INF/{AL2.0,LGPL2.1}\"\n            excludes += \"DebugProbesKt.bin\"\n        }\n    }\n}\n\ndependencies {\n    val composeBom = platform(\"androidx.compose:compose-bom:2024.06.00\")\n    implementation(composeBom)\n    implementation(\"androidx.core:core-ktx:1.13.1\")\n    implementation(\"androidx.lifecycle:lifecycle-runtime-ktx:2.8.3\")\n    implementation(\"androidx.activity:activity-compose:1.9.0\")\n    implementation(\"androidx.compose.ui:ui\")\n    implementation(\"androidx.compose.material3:material3\")\n}`;\n}\n\nexport function generateGitHubActionsApkYaml(): string {\n  return `name: Build MiGuard DNS Production Release APK\n\non:\n  push:\n    branches: [ \"main\", \"master\" ]\n  workflow_dispatch:\n\njobs:\n  build-apk:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v4\n\n      - name: Set up JDK 17\n        uses: actions/setup-java@v4\n        with:\n          java-version: \'17\'\n          distribution: \'temurin\'\n\n      - name: Setup Gradle 8.7\n        uses: gradle/actions/setup-gradle@v3\n        with:\n          gradle-version: \'8.7\'\n\n      - name: Generate Production Release Keystore\n        working-directory: ./android/app\n        run: |\n          if [ ! -f release-keystore.jks ]; then\n            keytool -genkeypair -v \\\\\n              -keystore release-keystore.jks \\\\\n              -alias miguard_key \\\\\n              -keyalg RSA \\\\\n              -keysize 2048 \\\\\n              -validity 10000 \\\\\n              -storepass miguard_prod_2026 \\\\\n              -keypass miguard_prod_2026 \\\\\n              -dname \"CN=MiGuard DNS, OU=Mobile, O=MiGuard, L=Hanoi, S=HN, C=VN\"\n          fi\n\n      - name: Build Signed Production Release APK (R8 Minified & Shrunk)\n        working-directory: ./android\n        env:\n          KEYSTORE_PASSWORD: miguard_prod_2026\n          KEY_ALIAS: miguard_key\n          KEY_PASSWORD: miguard_prod_2026\n        run: gradle assembleRelease --no-daemon\n\n      - name: Upload MiGuard-DNS-Production-Release.apk\n        uses: actions/upload-artifact@v4\n        with:\n          name: MiGuard-DNS-Production-Release-APK\n          path: android/app/build/outputs/apk/release/app-release.apk`;\n}\n\nexport function generateFullAndroidSetupScript(\n  rules: DomainRule[],\n  upstreamDns: DnsUpstream,\n  secondaryDns: DnsUpstream,\n  filterMode: AppFilterMode,\n  packages: SystemPackageItem[],\n  logRetentionDays: LogRetentionDays\n): string {\n  const vpnServiceKt = generateKotlinVpnServiceCode(\n    rules,\n    upstreamDns,\n    secondaryDns,\n    filterMode,\n    packages,\n    logRetentionDays\n  );\n  const packetHelperKt = generateDnsPacketHelperCode();\n  const manifestXml = generateAndroidManifestXml();\n  const appGradle = generateAppBuildGradleKts();\n  const workflowYml = generateGitHubActionsApkYaml();\n\n  return `#!/usr/bin/env bash\n# Script t\341\273\261 \304\221\341\273\231ng t\341\272\241o tr\341\273\215n b\341\273\231 d\341\273\261 \303\241n Android MiGuard DNS (B\341\272\243n Production Release \304\221\303\243 c\341\272\245u h\303\254nh R8 & Keystore)\nset -e\n\nmkdir -p MiGuardDNS/android/app/src/main/java/com/miguard/dns/vpn\nmkdir -p MiGuardDNS/.github/workflows\n\ncat << \'EOF\' > MiGuardDNS/android/settings.gradle.kts\npluginManagement {\n    repositories {\n        google()\n        mavenCentral()\n        gradlePluginPortal()\n    }\n}\ndependencyResolutionManagement {\n    repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)\n    repositories {\n        google()\n        mavenCentral()\n    }\n}\nrootProject.name = \"MiGuardDNS\"\ninclude(\":app\")\nEOF\n\ncat << \'EOF\' > MiGuardDNS/android/build.gradle.kts\nplugins {\n    id(\"com.android.application\") version \"8.5.2\" apply false\n    id(\"org.jetbrains.kotlin.android\") version \"1.9.24\" apply false\n}\nEOF\n\ncat << \'EOF\' > MiGuardDNS/android/app/proguard-rules.pro\n-optimizationpasses 5\n-keep public class com.miguard.dns.vpn.MiGuardVpnService { *; }\n-keep public class com.miguard.dns.MainActivity { *; }\nEOF\n\ncat << \'EOF\' > MiGuardDNS/android/app/build.gradle.kts\n${appGradle}\nEOF\n\ncat << \'EOF\' > MiGuardDNS/android/app/src/main/AndroidManifest.xml\n${manifestXml}\nEOF\n\ncat << \'EOF\' > MiGuardDNS/android/app/src/main/java/com/miguard/dns/vpn/DnsPacketHelper.kt\n${packetHelperKt}\nEOF\n\ncat << \'EOF\' > MiGuardDNS/android/app/src/main/java/com/miguard/dns/vpn/MiGuardVpnService.kt\n${vpnServiceKt}\nEOF\n\ncat << \'EOF\' > MiGuardDNS/.github/workflows/build-apk.yml\n${workflowYml}\nEOF\n\necho \"\304\220\303\243 t\341\272\241o xong d\341\273\261 \303\241n Android Production t\341\272\241i ./MiGuardDNS!\"\necho \"Ch\341\272\241y l\341\273\207nh: cd MiGuardDNS/android && gradle assembleRelease \304\221\341\273\203 xu\341\272\245t file app-release.apk \304\221\303\243 k\303\275 s\341\273\221 v\303\240 t\341\273\221i \306\260u R8.\"\n`;\n}"
