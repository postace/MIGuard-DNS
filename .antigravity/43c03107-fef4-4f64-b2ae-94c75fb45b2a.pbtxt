            }
            lines {
              text: "  const s = String(d.getSeconds()).padStart(2, \'0\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return `${h}:${m}:${s}`;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
