      thinking_signature: "\022\334\t\n\331\t\001i\024}\023\0218\354)\036\220:\377\252\225q\0234\223z\334B5-\325\241B\003\375EW\177\275\033\213\021\177\3466X\023\370\351\307L=\307\243z\031\016\364\020k\232v\bp1Y\376U\277Oj+I\325\v\215e\326\253dy\237\355\324\021Y\342\002>k\311\212Rqh\300Cb+\210\270\030\037\n\306}\241J\002}\001>z#\2168\251\232\210\037\016E\264\177\022^\240\222\'\322\334\314\263\002\373\036i\245{o@\207}\247p\250I2\223\207\251\a\235\f$\210%\207\310T\370\247e\355\277\326\204\006\373\303\000\245\37345\004\345\361,,\276\335H\267\304}M\374\214\316\333\270\333\2213<r\247\250\337.q}\331\270\357\365\034\003\022\354\362\030T\214\214e\315\222\3018B\263\357\323\214Z\005!\335\225\307\217\332\312j\357\272^\023W\200fd\223j\360A\030\005\244\201\342\317\023\f\370\336\234\271l4\202\026\037\000S#?(\324T\257CX^>\207\373\027`c\354\234\304\355\032QS\020u\255|\271o\345\245\353D+\t\350\233?\230uG\347@\237Cj\001\332Z\215y\027\222\203\2375]L\271\315v\250\034\367\265W\353M\r\260\006\272\213\357Cm\354\230\340\354\211Mo\346G\t\2177\357\220\':\275@\244\206\025\257\374)\346X\300\201x\275\350&/\323\371\254G\221\2353\244\251\200\304\252\3639\177%*\373\320^ZMU\371\313\a\177\345@\310c\t_c\302Z\203)t\231hi\334\367L:~\316\373a\177T6\362Be\241)\366$O;d\253\272\373]\371\000\"\223\201@\205\215\227\227\200Zc\262e#C\260_!\205\365v\254\205\213qaA2\320\331\330\202$\321\361F\216\272\216\034\031\326\245\\\325U\366\351W\316\300\035\361\316\274\344\350\343(\3025\260\237\307\301\301\207\240\376\223(\022=\356\205\272\267\324\037$\3112zC\234\245\325L\317\317\327P\3238#C\331\236@\254iPvC\307\001\216\327\036?\337\aAe\016\212R>\002\271\r]O\251o9\335\347\371\216\372G\210\325\237\026\306\320\312\327\241~\036F\315\311~\336\255\212\226\357\037\341\231\343\277];\036\020\331M\337\313\231\334\300M-5\037?B\275\373>\315\032\204K\246p\335\253\260B?\301\032(\210\021\360\351\r5/C\227\347+\373]\243J\271\226\023\2457r\336\257nT;\374{\036\217\276\360\234\\\377\245\024\316o\355 Wg\375\025J\002\266?\372~I\334\'&i=\0268iO\037\001\r\320y\037\206\222(\356\354t\004\v\223A\207\347\352\312\005\346\253&1\225\262%\351}\001y\313=\352b^\264\035\341\324\365\334\036\330s\321\034\225\265\340\273\b\310\345.\037=\276\033Nt\215\331\375\215\337\016Q\305&z\227\307\227<\310&\314X$R\r\246\257+\306\2663\353\037\221\234\235\023\226\334\254rVk\205l\362)\331PM/\255\325\241\251sY\300c4\344\255\022\263\000\343\002\200\322b\332`\320\030\357.\324P\263\3375O^S\324\025\036zZ\37334\034\225\261J\002\324\257Y\360\250\364Q\300\231\nNo\302\220\275#\2758\334\005\375\364\361\303o#\217\026\b\207\213\342\273\230\006R-\347\244\315\030t\032\n\377\363\333\032\v\347\371}}\346\311\246;\240/\255\022\315\320\2479[\307Av\243#-#\231\226I\247\340\220_M\232e\345\315W\201I\312=\311Pr\005\357\250\177N\351v\232%^\202\364q\324\354\003\347R.\274X\036\306g\202G\200g_\305\373\354\325\200!\215\301+\272\220\260\253hP\t\235\334\017\030>.\232\377D\337\031\367\346\324/@\262\374\224B\302?B\033\332/\364\006$.\r\301\260`\t\235\217v\232a\360p\033\2439\303\016&\311\027\n\006a\022\223%\277\032\331\245\312\205\325\300\b\034A\204\257\377\237&\350h#\252\221\271\t\bx\316\024\327\220.\237\022\036\260\342\021W\357\024i\2473b\370\340W\204\342J\300g\311O\230\303\323\323\363\274\231\257\331\220{\032n\0336j\222#\002V\034\306 \002D\263@\027\206\245\261=\'HP\261\3477\200\214\026\320\024\032\253=/\215\217Ah\226\002\243\325e\203\313\206\2125\250:7\232\304\2277{\367\026KD\274\222\347\357\205\237+\335LA\376\037z}\313\256\343\016\320s\032\033\034cZ\257\225\":\2238BX\021\234\245sB\\\"\254\034\211\003\306\265\202\017\206h\030\217\334L\326x\\Q\332\234\2562\244I\370\310\332\270\344\357\313\234W\307\221\313"
