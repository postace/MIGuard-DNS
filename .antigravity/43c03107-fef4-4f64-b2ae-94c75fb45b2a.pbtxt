            lines {
              text: "function formatTimeFromMs(epochMs: number): string {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const d = new Date(epochMs);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const h = String(d.getHours()).padStart(2, \'0\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
