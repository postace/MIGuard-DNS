      id: "call_464158"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"package com.miguard.dns.vpn\\n\\nimport java.nio.ByteBuffer\\n\\n/**\\n * DnsPacketHelper \342\200\224 B\341\273\231 gi\341\272\243i m\303\243 g\303\263i tin IPv4 + UDP + DNS v\303\240 t\341\272\241o ph\341\272\243n h\341\273\223i 0.0.0.0 (Sinkhole)\\n */\\nobject DnsPacketHelper {\\n\\n    fun isUdpDnsPacket(packet: ByteArray, length: Int): Boolean {\\n        if (length < 28) return false\\n        val version = (packet[0].toInt() ushr 4) and 0x0F\\n        if (version != 4) return false\\n        val protocol = packet[9].toInt() and 0xFF\\n        if (protocol != 17) return false // 17 = UDP\\n        val ipHeaderLen = (packet[0].toInt() and 0x0F) * 4\\n        if (length < ipHeaderLen + 8 + 12) return false\\n        val dstPort = ((packet[ipHeaderLen + 2].toInt() and 0xFF) shl 8) or\\n                (packet[ipHeaderLen + 3].toInt() and 0xFF)\\n        return dstPort == 53\\n    }\\n\\n    fun extractDomainName(packet: ByteArray, length: Int): String? {\\n        if (!isUdpDnsPacket(packet, length)) return null\\n        val ipHeaderLen = (packet[0].toInt() and 0x0F) * 4\\n        val dnsStart = ipHeaderLen + 8\\n        var pos = dnsStart + 12 // B\341\273\217 qua 12 bytes DNS Header\\n        val labels = mutableListOf<String>()\\n\\n        while (pos < length) {\\n            val labelLen = packet[pos].toInt() and 0xFF\\n            if (labelLen == 0) break\\n            if ((labelLen and 0xC0) == 0xC0) break\\n            pos++\\n            if (pos + labelLen > length) return null\\n            labels.add(String(packet, pos, labelLen, Charsets.UTF_8))\\n            pos += labelLen\\n        }\\n        return if (labels.isEmpty()) null else labels.joinToString(\\\".\\\")\\n    }\\n\\n    fun extractUdpPayload(packet: ByteArray, length: Int): ByteArray {\\n        val ipHeaderLen = (packet[0].toInt() and 0x0F) * 4\\n        val dnsOffset = ipHeaderLen + 8\\n        return packet.copyOfRange(dnsOffset, length)\\n    }\\n\\n    /**\\n     * T\341\272\241o g\303\263i tin ph\341\272\243n h\341\273\223i DNS tr\341\272\243 v\341\273\201 0.0.0.0 ngay l\341\272\255p t\341\273\251c cho c\303\241c t\303\252n mi\341\273\201n b\341\273\213 ch\341\272\267n\\n     */\\n    fun buildSinkholeResponse(requestPacket: ByteArray, requestLength: Int): ByteArray {\\n        val dnsQuery = extractUdpPayload(requestPacket, requestLength)\\n        val answerSection = byteArrayOf(\\n            0xC0.toByte(), 0x0C.toByte(), // Con tr\341\273\217 t\341\273\233i QNAME t\341\272\241i offset 12\\n            0x00, 0x01,                   // TYPE A (IPv4)\\n            0x00, 0x01,                   // CLASS IN\\n            0x00, 0x00, 0x00, 0x3C,       // TTL = 60 gi\303\242y\\n            0x00, 0x04,                   // RDLENGTH = 4 bytes\\n            0x00, 0x00, 0x00, 0x00        // RDATA = 0.0.0.0\\n        )\\n\\n        val dnsResponse = ByteArray(dnsQuery.size + answerSection.size)\\n        System.arraycopy(dnsQuery, 0, dnsResponse, 0, dnsQuery.size)\\n        // \304\220\341\272\267t c\341\273\235 QR=1 (Response), RD=1, RA=1, RCODE=0 (No error)\\n        dnsResponse[2] = 0x81.toByte()\\n        dnsResponse[3] = 0x80.toByte()\\n        // \304\220\341\272\267t ANCOUNT = 1\\n        dnsResponse[6] = 0x00\\n        dnsResponse[7] = 0x01\\n        System.arraycopy(answerSection, 0, dnsResponse, dnsQuery.size, answerSection.size)\\n\\n        return wrapUdpResponse(requestPacket, dnsResponse, dnsResponse.size)\\n    }\\n\\n    /**\\n     * \304\220\303\263ng g\303\263i payload DNS tr\341\272\243 v\341\273\201 v\303\240o g\303\263i tin IPv4 + UDP ho\303\240n ch\341\273\211nh \304\221\341\273\203 ghi v\303\240o giao di\341\273\207n TUN\\n     */\\n    fun wrapUdpResponse(\\n        originalRequest: ByteArray,\\n        dnsResponse: ByteArray,\\n        dnsLength: Int\\n    ): ByteArray {\\n        val ipHeaderLen = 20\\n        val udpHeaderLen = 8\\n        val totalLen = ipHeaderLen + udpHeaderLen + dnsLength\\n        val out = ByteBuffer.allocate(totalLen)\\n\\n        val reqIpHeaderLen = (originalRequest[0].toInt() and 0x0F) * 4\\n        val srcIp = originalRequest.copyOfRange(12, 16)\\n        val dstIp = originalRequest.copyOfRange(16, 20)\\n        val srcPort = originalRequest.copyOfRange(reqIpHeaderLen, reqIpHeaderLen + 2)\\n        val dstPort = originalRequest.copyOfRange(reqIpHeaderLen + 2, reqIpHeaderLen + 4)\\n\\n        // IPv4 Header (\304\221\341\272\243o chi\341\273\201u \304\221\341\273\213a ch\341\273\211 IP ngu\341\273\223n v\303\240 \304\221\303\255ch)\\n        out.put(0x45.toByte())\\n        out.put(0x00.toByte())\\n        out.putShort(totalLen.toShort())\\n        out.putShort(0.toShort())\\n        out.putShort(0x4000.toShort())\\n        out.put(64.toByte())\\n        out.put(17.toByte()) // UDP\\n        out.putShort(0.toShort()) // Checksum t\303\255nh sau\\n        out.put(dstIp)\\n        out.put(srcIp)\\n\\n        // UDP Header (\304\221\341\272\243o chi\341\273\201u c\341\273\225ng ngu\341\273\223n v\303\240 \304\221\303\255ch)\\n        out.put(dstPort)\\n        out.put(srcPort)\\n        out.putShort((udpHeaderLen + dnsLength).toShort())\\n        out.putShort(0.toShort()) // UDP checksum = 0 (t\303\271y ch\341\273\215n trong IPv4)\\n\\n        // DNS Payload\\n        out.put(dnsResponse, 0, dnsLength)\\n\\n        val raw = out.array()\\n        val checksum = computeIpv4Checksum(raw, ipHeaderLen)\\n        raw[10] = ((checksum ushr 8) and 0xFF).toByte()\\n        raw[11] = (checksum and 0xFF).toByte()\\n        return raw\\n    }\\n\\n    private fun computeIpv4Checksum(header: ByteArray, length: Int): Int {\\n        var sum = 0\\n        var i = 0\\n        while (i < length) {\\n            if (i != 10) {\\n                val word = ((header[i].toInt() and 0xFF) shl 8) or (header[i + 1].toInt() and 0xFF)\\n                sum += word\\n            }\\n            i += 2\\n        }\\n        while ((sum ushr 16) > 0) {\\n            sum = (sum and 0xFFFF) + (sum ushr 16)\\n        }\\n        return sum.inv() and 0xFFFF\\n    }\\n}\\n\",\"Description\":\"Create DnsPacketHelper.kt for parsing UDP DNS packets and generating 0.0.0.0 sinkhole responses\",\"Overwrite\":true,\"TargetFile\":\"/android/app/src/main/java/com/miguard/dns/vpn/DnsPacketHelper.kt\",\"toolAction\":\"Creating DnsPacketHelper.kt\",\"toolSummary\":\"Create DnsPacketHelper.kt for binary DNS packet handling\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_464291"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"package com.miguard.dns.vpn\\n\\nimport android.content.Intent\\nimport android.content.pm.PackageManager\\nimport android.net.VpnService\\nimport android.os.ParcelFileDescriptor\\nimport com.miguard.dns.data.PerAppMode\\nimport com.miguard.dns.data.VpnRepository\\nimport java.io.FileInputStream\\nimport java.io.FileOutputStream\\nimport java.net.DatagramPacket\\nimport java.net.DatagramSocket\\nimport java.net.InetAddress\\nimport kotlin.concurrent.thread\\n\\n/**\\n * MiGuardVpnService \342\200\224 D\341\273\213ch v\341\273\245 VPN c\341\273\245c b\341\273\231 ch\341\272\267n telemetry Xiaomi/MIUI v\341\273\201 0.0.0.0\\n * v\303\240 chuy\341\273\203n ti\341\272\277p c\303\241c truy v\341\272\245n h\341\273\243p l\341\273\207 ra DNS 1.1.1.1 ho\341\272\267c 8.8.8.8.\\n */\\nclass MiGuardVpnService : VpnService() {\\n\\n    companion object {\\n        const val ACTION_START = \\\"com.miguard.dns.START_VPN\\\"\\n        const val ACTION_STOP = \\\"com.miguard.dns.STOP_VPN\\\"\\n        const val VIRTUAL_TUN_IP = \\\"10.111.222.1\\\"\\n    }\\n\\n    private var vpnInterface: ParcelFileDescriptor? = null\\n    @Volatile private var isRunning = false\\n\\n    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {\\n        if (intent?.action == ACTION_STOP) {\\n            stopVpnTunnel()\\n            stopSelf()\\n            return START_NOT_STICKY\\n        }\\n\\n        // T\341\273\261 \304\221\341\273\231ng d\341\273\215n c\303\241c b\341\272\243n ghi log c\305\251 h\306\241n th\341\273\235i h\341\272\241n l\306\260u tr\341\273\257 (m\341\272\267c \304\221\341\273\213nh 7 ng\303\240y)\\n        VpnRepository.purgeExpiredLogs()\\n\\n        if (!isRunning) {\\n            isRunning = true\\n            VpnRepository.setVpnRunning(true)\\n            startDnsTunnel()\\n        }\\n        return START_STICKY\\n    }\\n\\n    private fun startDnsTunnel() {\\n        val primaryDns = VpnRepository.primaryDns.value\\n        val secondaryDns = if (primaryDns == \\\"1.1.1.1\\\") \\\"8.8.8.8\\\" else \\\"1.1.1.1\\\"\\n        val selectedPkgs = VpnRepository.selectedPackages.value\\n        val mode = VpnRepository.perAppMode.value\\n\\n        val builder = Builder()\\n            .setSession(\\\"MiGuard DNS\\\")\\n            .setMtu(1500)\\n            .addAddress(VIRTUAL_TUN_IP, 24)\\n            .addDnsServer(primaryDns)\\n            .addDnsServer(secondaryDns)\\n            .addRoute(primaryDns, 32)\\n            .addRoute(secondaryDns, 32)\\n\\n        selectedPkgs.forEach { pkg ->\\n            try {\\n                if (mode == PerAppMode.ALLOWLIST) {\\n                    builder.addAllowedApplication(pkg)\\n                } else {\\n                    builder.addDisallowedApplication(pkg)\\n                }\\n            } catch (_: PackageManager.NameNotFoundException) {\\n                // B\341\273\217 qua n\341\272\277u thi\341\272\277t b\341\273\213 kh\303\264ng c\303\263 package n\303\240y\\n            }\\n        }\\n\\n        vpnInterface = builder.establish() ?: run {\\n            stopVpnTunnel()\\n            return\\n        }\\n\\n        thread(name = \\\"MiGuard-DnsTunnel\\\", isDaemon = true) {\\n            val fd = vpnInterface?.fileDescriptor ?: return@thread\\n            val input = FileInputStream(fd)\\n            val output = FileOutputStream(fd)\\n            val buffer = ByteArray(1500)\\n\\n            while (isRunning) {\\n                try {\\n                    val length = input.read(buffer)\\n                    if (length > 0) {\\n                        val packetCopy = buffer.copyOf(length)\\n                        processPacket(packetCopy, length, output)\\n                    }\\n                } catch (_: Exception) {\\n                    if (!isRunning) break\\n                }\\n            }\\n        }\\n    }\\n\\n    private fun processPacket(rawPacket: ByteArray, length: Int, tunOutput: FileOutputStream) {\\n        val domain = DnsPacketHelper.extractDomainName(rawPacket, length) ?: return\\n        val startTime = System.currentTimeMillis()\\n\\n        if (VpnRepository.shouldBlockDomain(domain)) {\\n            val sinkholePacket = DnsPacketHelper.buildSinkholeResponse(rawPacket, length)\\n            synchronized(tunOutput) {\\n                tunOutput.write(sinkholePacket)\\n            }\\n            val elapsed = (System.currentTimeMillis() - startTime).coerceAtLeast(1L)\\n            VpnRepository.recordDnsLog(\\n                domain = domain,\\n                blocked = true,\\n                resolvedTarget = \\\"0.0.0.0\\\",\\n                latencyMs = elapsed\\n            )\\n        } else {\\n            val upstreamDns = VpnRepository.primaryDns.value\\n            thread(isDaemon = true) {\\n                try {\\n                    DatagramSocket().use { socket ->\\n                        protect(socket)\\n                        socket.soTimeout = 3000\\n                        val payload = DnsPacketHelper.extractUdpPayload(rawPacket, length)\\n                        val serverAddr = InetAddress.getByName(upstreamDns)\\n                        socket.send(DatagramPacket(payload, payload.size, serverAddr, 53))\\n\\n                        val respBuf = ByteArray(1500)\\n                        val respPacket = DatagramPacket(respBuf, respBuf.size)\\n                        socket.receive(respPacket)\\n\\n                        val wrapped = DnsPacketHelper.wrapUdpResponse(\\n                            originalRequest = rawPacket,\\n                            dnsResponse = respBuf,\\n                            dnsLength = respPacket.length\\n                        )\\n                        synchronized(tunOutput) {\\n                            tunOutput.write(wrapped)\\n                        }\\n                        val elapsed = (System.currentTimeMillis() - startTime).coerceAtLeast(1L)\\n                        VpnRepository.recordDnsLog(\\n                            domain = domain,\\n                            blocked = false,\\n                            resolvedTarget = upstreamDns,\\n                            latencyMs = elapsed\\n                        )\\n                    }\\n                } catch (_: Exception) {\\n                    // Timeout ho\341\272\267c kh\303\264ng c\303\263 k\341\272\277t n\341\273\221i m\341\272\241ng\\n                }\\n            }\\n        }\\n    }\\n\\n    private fun stopVpnTunnel() {\\n        isRunning = false\\n        VpnRepository.setVpnRunning(false)\\n        try {\\n            vpnInterface?.close()\\n        } catch (_: Exception) {\\n        }\\n        vpnInterface = null\\n    }\\n\\n    override fun onDestroy() {\\n        stopVpnTunnel()\\n        super.onDestroy()\\n    }\\n}\\n\",\"Description\":\"Create MiGuardVpnService.kt Android VpnService implementation\",\"Overwrite\":true,\"TargetFile\":\"/android/app/src/main/java/com/miguard/dns/vpn/MiGuardVpnService.kt\",\"toolAction\":\"Creating MiGuardVpnService.kt\",\"toolSummary\":\"Create MiGuardVpnService.kt Android service implementation\"}"
      original_name: "write_to_file"
    }
