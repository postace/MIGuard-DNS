<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Glow aura behind the shield -->
    <path
        android:pathData="M54,23 L79,32 C79,59 54,82 54,82 C54,82 29,59 29,32 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="46"
                android:gradientRadius="35"
                android:type="radial">
                <item android:color="#3310B981" android:offset="0.0" />
                <item android:color="#0010B981" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer shield body -->
    <path
        android:pathData="M54,27 L76,35 C76,57 54,76 54,76 C54,76 32,57 32,35 Z"
        android:strokeWidth="1.5">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="27"
                android:endX="76"
                android:endY="76"
                android:type="linear">
                <item android:color="#1E293B" android:offset="0.0" />
                <item android:color="#0F172A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="32"
                android:startY="27"
                android:endX="76"
                android:endY="76"
                android:type="linear">
                <item android:color="#34D399" android:offset="0.0" />
                <item android:color="#06B6D4" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner shield highlight -->
    <path
        android:pathData="M54,32 L71,38 C71,54 54,69 54,69 C54,69 37,54 37,38 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="37"
                android:startY="32"
                android:endX="71"
                android:endY="69"
                android:type="linear">
                <item android:color="#0F172A" android:offset="0.0" />
                <item android:color="#022C22" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central Security Checkmark / DNS Pulse -->
    <path
        android:pathData="M46,51 L52,57 L62,45"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="46"
                android:startY="45"
                android:endX="62"
                android:endY="57"
                android:type="linear">
                <item android:color="#10B981" android:offset="0.0" />
                <item android:color="#38BDF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Core Glow Dot -->
    <path
        android:pathData="M54,37m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0"
        android:fillColor="#34D399" />
</vector>
